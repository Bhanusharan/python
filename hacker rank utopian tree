def angryProfessor(k, a):
    on_time = sum(1 for time in a if time <= 0)
    return "YES" if on_time < k else "NO"

def utopianTree(n):
    height = 1
    for cycle in range(1, n + 1):
        if cycle % 2 == 1:      
            height *= 2
        else:                 
            height += 1
    return height

      
